{
  "name": "multichain-wallet-bot",
  "version": "1.0.0",
  "description": "Telegram command center for controlling many Solana wallets at once",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "netcheck": "tsx scripts/netcheck.ts",
    "check": "npm run typecheck && npm run smoke && npm run netcheck",
    "batchsim": "tsx scripts/batchsim.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "ed25519-hd-key": "^1.3.0",
    "grammy": "^1.32.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
