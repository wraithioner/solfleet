# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill it in.  Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# 1. Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Your numeric Telegram user ID. Get it from @userinfobot.
#    ONLY this ID can talk to the bot. Everyone else is ignored.
#    Comma-separate if you need more than one.
OWNER_IDS=123456789

# 3. Solana RPC. The public endpoint is heavily rate limited and WILL fail on
#    batch operations. Use a paid/private one (Helius, QuickNode, Triton, ...).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: separate endpoint for sending transactions (some providers offer a
# low-latency "sender" endpoint). Falls back to SOLANA_RPC_URL.
# SOLANA_SEND_RPC_URL=

# 4. EVM RPCs. Leave any blank to disable that chain.
ETHEREUM_RPC_URL=
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# 5. Vault security
#    Leave VAULT_PASSPHRASE empty (recommended): you unlock with /unlock <passphrase>
#    each time the bot starts, and the key only ever lives in memory.
#    Set it only if you need unattended restarts on a VPS you trust.
VAULT_PASSPHRASE=
# Minutes of inactivity before the vault auto-locks itself. 0 = never.
VAULT_AUTOLOCK_MINUTES=30

# 6. Trading defaults
DEFAULT_SLIPPAGE_PERCENT=15
DEFAULT_PRIORITY_FEE_SOL=0.00005
# "bundle" = atomic Jito bundles, 5 wallets per bundle, best for same-block entries.
# "parallel" = fire each wallet's tx independently. More resilient, less atomic.
DEFAULT_EXECUTION_MODE=parallel
# Max wallets hitting the RPC at the same time in parallel mode.
EXECUTION_CONCURRENCY=5
# Jito tip in SOL, used only in bundle mode.
JITO_TIP_SOL=0.0001

# 7. Safety rails
#    Refuse any single buy larger than this many SOL per wallet.
MAX_BUY_SOL_PER_WALLET=5
#    Require an explicit confirmation tap for every write operation.
REQUIRE_CONFIRMATION=true

# 8. Storage location for the encrypted vault + wallet index
DATA_DIR=./data
